# Kessel configuration (env overrides flags' defaults; flags still win over env).
# Copy to .env for local docker-compose use.

# HTTP listen port
KESSEL_PORT=8080

# Data directory (SQLite DB, AES key, and rendered reports live here)
KESSEL_DATA_DIR=/data

# PageSpeed Insights API key (optional; keyless works with heavy rate limits)
# KESSEL_PSI_API_KEY=

# Max concurrent PSI checks
KESSEL_PSI_CONCURRENCY=2

# Logging
KESSEL_LOG_LEVEL=info
KESSEL_LOG_FORMAT=json

# 32-byte hex key for encrypting secrets at rest.
# Leave blank to generate and persist one to <data-dir>/kessel.key on first run.
# KESSEL_ENCRYPTION_KEY=

# Timezone (affects cron schedules and timestamps in logs)
TZ=UTC
