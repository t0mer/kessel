<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kessel report — {{.Site.Name}} ({{.Run.Strategy}})</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 0; padding: 2rem; background:#0f172a; color:#e2e8f0; }
  .wrap { max-width: 900px; margin: 0 auto; }
  h1 { font-size: 1.4rem; margin: 0 0 .25rem; }
  .meta { color:#94a3b8; font-size:.9rem; margin-bottom:1.5rem; }
  .meta a { color:#7dd3fc; }
  .gauges { display:flex; flex-wrap:wrap; gap:1rem; margin-bottom:2rem; }
  .gauge { flex:1 1 160px; background:#1e293b; border-radius:12px; padding:1rem; text-align:center; }
  .gauge .score { font-size:2.2rem; font-weight:700; }
  .gauge .label { color:#94a3b8; font-size:.85rem; text-transform:uppercase; letter-spacing:.05em; }
  .good{color:#22c55e} .avg{color:#f59e0b} .poor{color:#ef4444} .na{color:#64748b}
  table { width:100%; border-collapse:collapse; margin-bottom:2rem; }
  th,td { text-align:left; padding:.5rem .75rem; border-bottom:1px solid #334155; }
  th { color:#94a3b8; font-weight:600; font-size:.85rem; }
  h2 { font-size:1.1rem; border-bottom:1px solid #334155; padding-bottom:.4rem; }
  .empty { color:#64748b; font-style:italic; }
  footer { color:#64748b; font-size:.8rem; margin-top:2rem; }
</style>
</head>
<body>
<div class="wrap">
  <h1>{{.Site.Name}}</h1>
  <div class="meta">
    <a href="{{.Site.URL}}">{{.Site.URL}}</a> · strategy: {{.Run.Strategy}} ·
    status: {{.Run.Status}} · checked: {{.StartedAt}}
  </div>

  <div class="gauges">
    {{template "gauge" dict "Label" "Performance" "V" .Run.Perf}}
    {{template "gauge" dict "Label" "Accessibility" "V" .Run.Accessibility}}
    {{template "gauge" dict "Label" "Best Practices" "V" .Run.BestPractices}}
    {{template "gauge" dict "Label" "SEO" "V" .Run.SEO}}
  </div>

  <h2>Core Web Vitals (lab)</h2>
  <table>
    <tr><th>Metric</th><th>Value</th></tr>
    <tr><td>Largest Contentful Paint</td><td>{{ms .Run.LCPms}}</td></tr>
    <tr><td>Cumulative Layout Shift</td><td>{{num .Run.CLS}}</td></tr>
    <tr><td>Total Blocking Time</td><td>{{ms .Run.TBTms}}</td></tr>
    <tr><td>First Contentful Paint</td><td>{{ms .Run.FCPms}}</td></tr>
    <tr><td>Speed Index</td><td>{{ms .Run.SIms}}</td></tr>
    <tr><td>Time to Interactive</td><td>{{ms .Run.TTIms}}</td></tr>
  </table>

  <h2>Opportunities</h2>
  {{if .Opportunities}}
  <table>
    <tr><th>Opportunity</th><th>Detail</th><th>Est. savings</th></tr>
    {{range .Opportunities}}
    <tr><td>{{.Title}}</td><td>{{.DisplayValue}}</td><td>{{printf "%.0f ms" .SavingsMs}}</td></tr>
    {{end}}
  </table>
  {{else}}
  <p class="empty">No opportunities reported.</p>
  {{end}}

  <footer>Generated by Kessel at {{.GeneratedAt}}.</footer>
</div>
</body>
</html>
{{define "gauge"}}
  <div class="gauge">
    <div class="score {{cls .V}}">{{score .V}}</div>
    <div class="label">{{.Label}}</div>
  </div>
{{end}}
